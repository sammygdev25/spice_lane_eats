# Copy to backend/.env for local development. Production: set these in the host's environment.
DATABASE_URL="postgresql://app:app@localhost:5432/app"
JWT_SECRET=${JWT_SECRET:-changeme-in-production}
PORT=8000
NODE_ENV=development
CORS_ALLOWED_ORIGINS="http://localhost:5173"
SEED_DEMO=0
LOG_LEVEL=info
SERVE_FRONTEND=auto
# Stripe (payments): the sandbox secret key and the webhook signing secret.
# Production: set them in the host's environment, never in the code.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd
