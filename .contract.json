{
  "name": "spice_lane_eats",
  "description": "Restaurant ordering app for Spice Lane with menu browsing, cart, Stripe checkout, pickup/delivery, order history, and staff menu management",
  "tech": {
    "backend_port": 8000,
    "frontend_port": 3000,
    "api_base_url": "http://localhost:8000/api",
    "auth_strategy": "jwt",
    "state_management": "context",
    "database": "sqlite3",
    "css_framework": "tailwind",
    "project_type": "fullstack_express",
    "game_engine": "",
    "game_interfaces": {},
    "frontend_framework": "react",
    "python_packages": [],
    "node_packages": {
      "axios": "^1.6.0",
      "react-router-dom": "^6.20.0",
      "@prisma/client": "^5.7.0",
      "prisma": "^5.7.0",
      "bcryptjs": "^2.4.3",
      "jsonwebtoken": "^9.0.2",
      "stripe": "^14.5.0",
      "@stripe/stripe-js": "^2.2.0",
      "cors": "^2.8.5",
      "express": "^4.18.2",
      "dotenv": "^16.3.1"
    },
    "typescript": true,
    "user_roles": [
      "customer",
      "staff"
    ],
    "production_security": true,
    "google_oauth": false,
    "payments": true,
    "payments_effect": false,
    "delivery_fee": 3.99
  },
  "models": [
    {
      "name": "User",
      "app_label": "api",
      "fields": [
        {
          "name": "email",
          "type": "EmailField",
          "kwargs": {
            "unique": "True"
          }
        },
        {
          "name": "password",
          "type": "CharField",
          "kwargs": {
            "max_length": "255"
          }
        },
        {
          "name": "name",
          "type": "CharField",
          "kwargs": {
            "max_length": "150"
          }
        },
        {
          "name": "phone",
          "type": "CharField",
          "kwargs": {
            "max_length": "20",
            "blank": "True"
          }
        },
        {
          "name": "role",
          "type": "CharField",
          "kwargs": {
            "max_length": "20",
            "choices": [
              [
                "customer",
                "Customer"
              ],
              [
                "staff",
                "Staff"
              ]
            ],
            "default": "'customer'"
          }
        },
        {
          "name": "created_at",
          "type": "DateTimeField",
          "kwargs": {
            "auto_now_add": "True"
          }
        },
        {
          "name": "updated_at",
          "type": "DateTimeField",
          "kwargs": {
            "auto_now": "True"
          }
        }
      ],
      "meta": {
        "ordering": "['-created_at']"
      },
      "str_field": "email"
    },
    {
      "name": "Category",
      "app_label": "api",
      "fields": [
        {
          "name": "name",
          "type": "CharField",
          "kwargs": {
            "max_length": "100"
          }
        },
        {
          "name": "display_order",
          "type": "IntegerField",
          "kwargs": {
            "default": "0"
          }
        },
        {
          "name": "created_at",
          "type": "DateTimeField",
          "kwargs": {
            "auto_now_add": "True"
          }
        },
        {
          "name": "updated_at",
          "type": "DateTimeField",
          "kwargs": {
            "auto_now": "True"
          }
        }
      ],
      "meta": {
        "ordering": "['display_order']"
      },
      "str_field": "name"
    },
    {
      "name": "MenuItem",
      "app_label": "api",
      "fields": [
        {
          "name": "name",
          "type": "CharField",
          "kwargs": {
            "max_length": "200"
          }
        },
        {
          "name": "description",
          "type": "TextField",
          "kwargs": {
            "blank": "True"
          }
        },
        {
          "name": "price",
          "type": "DecimalField",
          "kwargs": {
            "max_digits": "6",
            "decimal_places": "2"
          }
        },
        {
          "name": "category",
          "type": "ForeignKey",
          "kwargs": {
            "to": "'Category'",
            "on_delete": "models.CASCADE",
            "related_name": "'menu_items'"
          }
        },
        {
          "name": "image_url",
          "type": "CharField",
          "kwargs": {
            "max_length": "500",
            "blank": "True"
          }
        },
        {
          "name": "is_available",
          "type": "BooleanField",
          "kwargs": {
            "default": "True"
          }
        },
        {
          "name": "created_at",
          "type": "DateTimeField",
          "kwargs": {
            "auto_now_add": "True"
          }
        },
        {
          "name": "updated_at",
          "type": "DateTimeField",
          "kwargs": {
            "auto_now": "True"
          }
        }
      ],
      "meta": {
        "ordering": "['category', 'name']"
      },
      "str_field": "name"
    },
    {
      "name": "Order",
      "app_label": "api",
      "fields": [
        {
          "name": "user",
          "type": "ForeignKey",
          "kwargs": {
            "to": "'User'",
            "on_delete": "models.CASCADE",
            "related_name": "'orders'"
          }
        },
        {
          "name": "customer_name",
          "type": "CharField",
          "kwargs": {
            "max_length": "150"
          }
        },
        {
          "name": "phone",
          "type": "CharField",
          "kwargs": {
            "max_length": "20"
          }
        },
        {
          "name": "order_type",
          "type": "CharField",
          "kwargs": {
            "max_length": "20",
            "choices": [
              [
                "pickup",
                "Pickup"
              ],
              [
                "delivery",
                "Delivery"
              ]
            ]
          }
        },
        {
          "name": "delivery_address",
          "type": "CharField",
          "kwargs": {
            "max_length": "300",
            "blank": "True"
          }
        },
        {
          "name": "delivery_fee",
          "type": "DecimalField",
          "kwargs": {
            "max_digits": "5",
            "decimal_places": "2",
            "default": "0"
          }
        },
        {
          "name": "notes",
          "type": "TextField",
          "kwargs": {
            "blank": "True"
          }
        },
        {
          "name": "total_amount",
          "type": "DecimalField",
          "kwargs": {
            "max_digits": "8",
            "decimal_places": "2"
          }
        },
        {
          "name": "status",
          "type": "CharField",
          "kwargs": {
            "max_length": "20",
            "choices": [
              [
                "pending",
                "Pending"
              ],
              [
                "paid",
                "Paid"
              ],
              [
                "preparing",
                "Preparing"
              ],
              [
                "completed",
                "Completed"
              ],
              [
                "cancelled",
                "Cancelled"
              ]
            ],
            "default": "'pending'"
          }
        },
        {
          "name": "created_at",
          "type": "DateTimeField",
          "kwargs": {
            "auto_now_add": "True"
          }
        },
        {
          "name": "updated_at",
          "type": "DateTimeField",
          "kwargs": {
            "auto_now": "True"
          }
        }
      ],
      "meta": {
        "ordering": "['-created_at']"
      },
      "str_field": "customer_name"
    },
    {
      "name": "OrderItem",
      "app_label": "api",
      "fields": [
        {
          "name": "order",
          "type": "ForeignKey",
          "kwargs": {
            "to": "'Order'",
            "on_delete": "models.CASCADE",
            "related_name": "'items'"
          }
        },
        {
          "name": "menu_item",
          "type": "ForeignKey",
          "kwargs": {
            "to": "'MenuItem'",
            "on_delete": "models.PROTECT",
            "related_name": "'order_items'"
          }
        },
        {
          "name": "quantity",
          "type": "IntegerField",
          "kwargs": {
            "default": "1"
          }
        },
        {
          "name": "price",
          "type": "DecimalField",
          "kwargs": {
            "max_digits": "6",
            "decimal_places": "2"
          }
        },
        {
          "name": "created_at",
          "type": "DateTimeField",
          "kwargs": {
            "auto_now_add": "True"
          }
        }
      ],
      "meta": {
        "ordering": "['id']"
      },
      "str_field": "menu_item"
    }
  ],
  "endpoints": [
    {
      "path": "/api/auth/register/",
      "methods": [
